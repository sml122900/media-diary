# 릴리즈 서명 설정 템플릿 (Stage 11.4.3)
#
# 1. 이 파일을 keystore.properties로 복사
# 2. 아래 값을 실제 키스토어 정보로 채움
# 3. keystore.properties는 절대 git에 커밋하지 않음 (.gitignore에 이미 등록됨)
#
# storeFile은 git 저장소 밖의 안전한 경로를 절대경로로 지정하는 것을 권장
# (예: C:/Users/본인계정/keystores/media-diary-release.keystore)

storeFile=C:/absolute/path/to/media-diary-release.keystore
storePassword=CHANGE_ME
keyAlias=media-diary
keyPassword=CHANGE_ME
